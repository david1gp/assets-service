{
  "name": "@adaptive-ds/assets-service",
  "version": "0.2.0",
  "description": "HTTP service for storing, transforming, and serving images, video, fonts, and documents for Adaptive DS sites.",
  "keywords": [
    "assets",
    "images",
    "video",
    "fonts",
    "optimization",
    "cdn",
    "media",
    "imagemagick",
    "typescript",
    "bun",
    "adaptive-ds"
  ],
  "homepage": "https://github.com/david1gp/assets-service",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david1gp/assets-service.git"
  },
  "bugs": {
    "url": "https://github.com/david1gp/assets-service/issues"
  },
  "author": {
    "name": "David Siewert",
    "url": "https://david-siewert.com/"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/david1gp"
  },
  "license": "MIT",
  "readme": "README.md",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "./dist/library.js",
  "types": "./dist/library.d.ts",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run api",
    "dev:ui": "bun run vite:dev",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "rsbuild:dev": "rsbuild dev",
    "rsbuild:build": "rsbuild build",
    "api": "bun run src/entrypoints/api.ts",
    "worker": "bun run src/entrypoints/worker.ts",
    "assets": "bun run src/entrypoints/assets-cli.ts",
    "assets-local": "bun run src/entrypoints/assets-local-cli.ts",
    "ops:migrate": "bun run src/entrypoints/database-migrate.ts",
    "ops:doctor": "bun run src/entrypoints/doctor.ts",
    "ops:backup": "bash ./ops/backup.sh",
    "ops:restore": "bash ./ops/sqlite-restore.sh",
    "ops:reconcile": "bash ./ops/reconcile.sh",
    "ops:sqlite-snapshot": "bun run src/entrypoints/sqlite-snapshot.ts",
    "ops:sqlite-restore": "bun run src/entrypoints/sqlite-restore.ts",
    "test": "bun test",
    "test:w": "bun test --watch",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "typecheck:ui": "tsc -p ./tsconfig.ui.json --noEmit",
    "tsc": "tsc -p ./tsconfig.json --noEmit",
    "build": "bun run clean && bun run typecheck && tsc -p ./tsconfig.lib.json && chmod +x dist/entrypoints/assets-cli.js dist/entrypoints/assets-local-cli.js",
    "check": "bun run format:check && bun run typecheck && bun run typecheck:ui && bun test && bun run build && bun run vite:build",
    "release": "bash ./ops/release.sh",
    "deploy": "bash ./ops/deploy.sh",
    "ops:validate": "bun test test/operationsArtifacts.test.ts",
    "format": "biome format --write src test ops docs package.json tsconfig.json tsconfig.lib.json biome.json bunfig.toml cliff.toml README.md",
    "format:check": "biome format src test ops docs package.json tsconfig.json tsconfig.lib.json biome.json bunfig.toml cliff.toml README.md",
    "update": "bun update",
    "update:commit": "bun update && git add package.json && bun run tsc && git commit -m \"chore(deps): update dependencies\" && git push",
    "clean": "rm -rf ./dist",
    "reset": "rm -rf ./node_modules",
    "fixture:server": "bun run src/entrypoints/fixture-server.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@rsbuild/core": "^2.0.13",
    "@rsbuild/plugin-babel": "^1.2.1",
    "@rsbuild/plugin-solid": "^1.2.2",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1",
    "vite-plugin-solid": "^2.11.11"
  },
  "dependencies": {
    "@corvu/dialog": "^0.2.4",
    "@mdi/js": "^7.4.47",
    "@solid-primitives/keyed": "^1.5.3",
    "@solidjs/router": "^1.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fontkit": "^2.0.4",
    "hono": "^4.13.2",
    "sharp": "^0.35.3",
    "solid-js": "^1.9.12",
    "tailwind-merge": "^3.6.0",
    "ttf2woff2": "^8.0.1",
    "typescript": "^6.0.3",
    "valibot": "^1.4.2"
  },
  "imports": {
    "#ui/*.js": "./ui/*.ts",
    "#ui/*.jsx": "./ui/*.tsx",
    "#ui/*": "./ui/*"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "assets": "./dist/entrypoints/assets-cli.js",
    "assets-local": "./dist/entrypoints/assets-local-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
