{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "paths": {
      "#ui/*.js": ["./ui/*.ts"],
      "#ui/*.jsx": ["./ui/*.tsx"],
      "#ui/*": ["./ui/*"]
    },
    "noEmit": true,
    //
    // dom
    //
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["bun", "vite/client"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    //
    // performance
    //
    "isolatedModules": true,
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "./build/tsconfig.tsbuildinfo",
    //
    // my configs
    //
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "useDefineForClassFields": true,
    "moduleDetection": "force",
    "noUncheckedSideEffectImports": true,
    //
    // type imports - https://www.typescriptlang.org/tsconfig#verbatimModuleSyntax
    //
    "verbatimModuleSyntax": true,
    //
    // https://devblogs.microsoft.com/typescript/announcing-typescript-5-8/#the---erasablesyntaxonly-option
    //
    "erasableSyntaxOnly": true,
    //
    // code quality settings
    //
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["client", "src", "test", "vite.config.ts", "rsbuild.config.ts"],
  "exclude": [
    ".github",
    ".roo",
    ".idea",
    ".vscode",
    ".wrangler",
    "changelogs",
    "build",
    "dist",
    "out",
    "data",
    "docs",
    "node_modules",
    "ops",
    "public",
    "public-image-versions",
    "public-images"
  ]
}
