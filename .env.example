# Copy to .env for Compose or ~/.config/assets-service/assets-service.env for systemd.
# Replace every CHANGE_ME value. Never commit the copied file.

ASSETS_ENVIRONMENT=production
ASSETS_API_HOST=https://assets-api.example.test
ASSETS_API_PORT=8787
ASSETS_PUBLISHED_API_PORT=8787
ASSETS_DATABASE_PATH=/var/lib/assets-service/assets.sqlite
ASSETS_WORKER_ID=assets-worker-1

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME_ACCOUNT_ID
R2_ACCESS_KEY_ID=CHANGE_ME_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY
ASSETS_R2_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
# Service-level operational/fallback bucket settings. Project environment bucket names
# and public domains are managed through project settings/API at runtime; they do not
# need startup allowlisting.
ASSETS_R2_BUCKET=CHANGE_ME_assets-operational
ASSETS_R2_PRIVATE_BUCKET=CHANGE_ME_assets-private
ASSETS_R2_PUBLIC_BUCKET=CHANGE_ME_assets-public
# Optional service-level operational overrides/fallbacks:
# ASSETS_R2_DEVELOPMENT_BUCKET=CHANGE_ME_assets-development
# ASSETS_R2_PRODUCTION_BUCKET=CHANGE_ME_assets-production
# ASSETS_R2_PRODUCTION_PUBLIC_BASE_URL=https://assets.example.test
# ASSETS_R2_PUBLIC_BASE_URL=https://assets.example.test
# Optional probe object path used by the R2 custom-domain doctor.
# ASSETS_R2_CUSTOM_DOMAIN_PROBE_KEY=health.txt

# rclone must have a local gdrive_beta remote. The application only uses copyto,
# size, check, lsd, version, and listremotes. sync and bisync are forbidden.
ASSETS_RCLONE_EXECUTABLE=rclone
ASSETS_RCLONE_REMOTE=gdrive_beta
ASSETS_RCLONE_BACKUP_ROOT=backups
ASSETS_RCLONE_TIMEOUT_MS=300000
RCLONE_CONFIG_HOST_PATH=/etc/assets-service/rclone.conf

ASSETS_FFPROBE_EXECUTABLE=ffprobe
# Comma-separated, absolute paths. Leave empty when legacy imports are disabled.
ASSETS_LEGACY_IMPORT_ROOTS=

# Zitadel OIDC
ZITADEL_ISSUER=https://login.example.test
ZITADEL_CLIENT_ID=CHANGE_ME_ZITADEL_CLIENT_ID
ZITADEL_SERVICE_ACCOUNT_CLIENT_ID=CHANGE_ME_ZITADEL_SERVICE_ACCOUNT_CLIENT_ID
ZITADEL_REDIRECT_URI=https://assets-api.example.test/api/v1/auth/callback
ZITADEL_AUDIENCE=CHANGE_ME_ZITADEL_AUDIENCE
ZITADEL_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
ZITADEL_PROJECT_ID=00000000-0000-0000-0000-000000000000
ASSETS_SESSION_COOKIE_NAME=assets_session
ASSETS_STATE_COOKIE_NAME=assets_state
ASSETS_SESSION_TTL_SECONDS=28800
ASSETS_SESSION_ROTATION_SECONDS=900
ASSETS_AUTH_CLOCK_SKEW_SECONDS=30
ASSETS_JWKS_CACHE_TTL_SECONDS=300

# Telegram is optional. Set both values to enable the worker outbox dispatcher.
# ASSETS_TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
# ASSETS_TELEGRAM_CHAT_ID=CHANGE_ME_TELEGRAM_CHAT_ID
ASSETS_TELEGRAM_API_BASE_URL=https://api.telegram.org
ASSETS_TELEGRAM_TIMEOUT_MS=10000
ASSETS_TELEGRAM_MAX_ATTEMPTS=5
ASSETS_TELEGRAM_RETRY_BASE_MS=1000
ASSETS_TELEGRAM_LEASE_MS=60000
ASSETS_TELEGRAM_POLL_MS=1000

# Compose and maintenance defaults.
ASSETS_IMAGE_TAG=local
ASSETS_ENV_FILE=.env
